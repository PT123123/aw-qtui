<?xml version="1.0" encoding="UTF-8"?>
<!-- inboxsettingspage.ui —— 收件箱设置页布局（Qt Designer）
     与 InboxSettingsPage::buildUi() 的静态结构一一对应。注意：
     1. 边距/间距/标签最小宽为基准值，si() 缩放几何在 buildUi() 中重设；
     2. sp() 动态字号样式保留在 applyStyle()；设备名/ID/平台取值与勾选状态运行时填充；
     3. 回收站子页（awqtui::TrashPage）经 customwidget 声明嵌入 -->
<ui version="4.0">
 <class>InboxSettingsPage</class>
 <widget class="QWidget" name="InboxSettingsPage">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>720</width>
    <height>520</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="rootLayout" stretch="0,1">
   <property name="leftMargin">
    <number>20</number>
   </property>
   <property name="topMargin">
    <number>16</number>
   </property>
   <property name="rightMargin">
    <number>20</number>
   </property>
   <property name="bottomMargin">
    <number>16</number>
   </property>
   <property name="spacing">
    <number>12</number>
   </property>
   <item>
    <widget class="QLabel" name="title">
     <property name="text">
      <string>收件箱设置</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QTabWidget" name="tabs">
     <property name="documentMode">
      <bool>true</bool>
     </property>
     <widget class="QWidget" name="general">
      <attribute name="title">
       <string>⚙ 通用</string>
      </attribute>
      <layout class="QVBoxLayout" name="generalLay" stretch="0,0,0,0,0,0,0,1">
       <property name="leftMargin">
        <number>16</number>
       </property>
       <property name="topMargin">
        <number>16</number>
       </property>
       <property name="rightMargin">
        <number>16</number>
       </property>
       <property name="bottomMargin">
        <number>16</number>
       </property>
       <property name="spacing">
        <number>10</number>
       </property>
       <item>
        <layout class="QHBoxLayout" name="nameRow">
         <item>
          <widget class="QLabel" name="nameLabel">
           <property name="text">
            <string>设备名</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="deviceName">
           <property name="clearButtonEnabled">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="idRow">
         <item>
          <widget class="QLabel" name="idLabel">
           <property name="text">
            <string>设备 ID</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="deviceId"/>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="platRow">
         <item>
          <widget class="QLabel" name="platLabel">
           <property name="text">
            <string>平台</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="platformLabel"/>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="gap">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeType">
          <enum>QSizePolicy::Fixed</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>8</width>
           <height>8</height>
          </size>
         </property>
        </spacer>
       </item>
       <item>
        <widget class="QCheckBox" name="autoManage">
         <property name="text">
          <string>自动管理本地服务端（探测 / 拉起 / 看护）</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="autostart">
         <property name="text">
          <string>开机自启（Task Scheduler ONLOGON）</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="status"/>
       </item>
       <item>
        <spacer name="verticalStretch">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="trashHost">
      <attribute name="title">
       <string>🗑 回收站</string>
      </attribute>
      <layout class="QVBoxLayout" name="trashHostLay">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <property name="spacing">
        <number>0</number>
       </property>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
