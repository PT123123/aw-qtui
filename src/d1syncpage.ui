      <item row="1" column="0">
       <widget class="QLabel" name="lblDatabaseId">
        <property name="text">
         <string>Database ID</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QLineEdit" name="databaseId">
        <property name="placeholderText">
         <string>D1 数据库 UUID</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="lblApiToken">
        <property name="text">
         <string>API Token</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QLineEdit" name="apiToken">
        <property name="echoMode">
         <enum>QLineEdit::Password</enum>
        </property>
        <property name="placeholderText">
         <string>Cloudflare API Token（需含 D1 读写权限）</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="chkEnabled">
        <property name="text">
         <string>启用 D1 云同步</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="lblInterval">
        <property name="text">
         <string>同步间隔</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QSpinBox" name="interval">
        <property name="toolTip">
         <string>后台周期同步间隔，最小 30 秒</string>
        </property>
        <property name="minimum">
         <number>30</number>
        </property>
        <property name="maximum">
         <number>86400</number>
        </property>
        <property name="singleStep">
         <number>30</number>
        </property>
        <property name="value">
         <number>300</number>
        </property>
        <property name="suffix">
         <string> 秒</string>
        </property>
       </widget>
      </item>
