<?xml version="1.0" encoding="UTF-8"?>
<!-- querypage.ui —— Query Explorer 页布局（Qt Designer）
     与 QueryPage::buildUi() 的静态结构一一对应。注意：
     1. 控件名直接取主题 QSS 的 objectName 角色（PageTitle/SectionTitle/QueryEditor/QueryResult/PrimaryBtn）；
     2. 下拉条目文本进 .ui，userData（天数 / 时区标志）运行时 setItemData 补齐；
     3. daySpin 默认隐藏、等宽字体、状态标签主题色在 querypage.cpp 处理 -->
