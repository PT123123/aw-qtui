<?xml version="1.0" encoding="UTF-8"?>
<!-- daypage.ui —— 【时间线/日审阅】页布局（Qt Designer），仅编辑模式。静态结构注意：
     1. 控件名保持唯一，主题 QSS 的 objectName 角色（ToolBtn/PrimaryBtn/ToolbarLabel）
        在 DayPage::buildUi() 统一映射；ToolbarLabel 样式由 DayPage::applyTheme() 内联定义；
     2. 顶部日期导航行含时间范围选择：「1天 / 7天」排他按钮（rangeBtn1d/rangeBtn7d，
        QButtonGroup 运行时维护）+「起始日期」QDateEdit（自定义范围，运行时清除按钮选中态）；
     3. editBar（选择/打标签/过滤/重置视图）与 stack 主区（timeline+bottomTabs / untaggedScroll）；
     4. awqtui::TimelineWidget 经 customwidget 声明，可框选（运行时可配置）；
        UntaggedView 构造需 TagStore*，.ui 中 QScrollArea 留空、运行时 setWidget；
     5. QSplitter 子项拉伸经 <attribute name="stretch"> 声明（3,2） -->
