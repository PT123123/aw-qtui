<?xml version="1.0" encoding="UTF-8"?>
<!-- statspage.ui —— 多日统计页布局（Qt Designer）
     与 StatsPage 构造函数中的静态结构一一对应。注意：
     1. Tab 内容（Top/Day duration/Attendance/Custom）为动态构建，保留在 statspage.cpp；
     2. 控件名保持唯一，主题 QSS 的 objectName 角色（ToolBtn/PrimaryBtn）在构造函数中统一映射；
     3. 默认日期范围、平均值勾选初始状态在运行时设置 -->
<ui version="4.0">
 <class>StatsPage</class>
 <widget class="QWidget" name="StatsPage">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>600</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="rootLayout" stretch="0,1,0">
   <property name="leftMargin">
    <number>14</number>
   </property>
   <property name="topMargin">
    <number>12</number>
   </property>
   <property name="rightMargin">
    <number>14</number>
   </property>
   <property name="bottomMargin">
    <number>12</number>
   </property>
   <property name="spacing">
    <number>10</number>
   </property>
   <item>
    <layout class="QHBoxLayout" name="top">
     <item>
      <widget class="QLabel" name="fromLabel">
       <property name="text">
        <string>From</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QDateEdit" name="fromEdit">
       <property name="calendarPopup">
        <bool>true</bool>
       </property>
       <property name="displayFormat">
        <string>yyyy-MM-dd</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="toLabel">
       <property name="text">
        <string>To</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QDateEdit" name="toEdit">
       <property name="calendarPopup">
        <bool>true</bool>
       </property>
       <property name="displayFormat">
        <string>yyyy-MM-dd</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="weekBtn">
       <property name="text">
        <string>本周</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="monthBtn">
       <property name="text">
        <string>本月</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="avgCheck">
       <property name="text">
        <string>平均值</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="topStretch">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="addTabBtn">
       <property name="text">
        <string>＋ 新建统计</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="refreshBtn">
       <property name="text">
        <string>刷新</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="exportBtn">
       <property name="text">
        <string>导出 CSV</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QTabWidget" name="tabs">
     <property name="tabsClosable">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="status"/>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
