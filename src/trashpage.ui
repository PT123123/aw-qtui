<?xml version="1.0" encoding="UTF-8"?>
<!-- trashpage.ui —— 回收站页布局（Qt Designer）
     与 TrashPage::buildUi() 的静态结构一一对应。注意：
     1. 边距/间距为基准值，si() 缩放几何在 buildUi() 中运行时重设；
     2. 标题/计数标签的 sp() 动态字号样式保留在 trashpage.cpp 的 applyStyle() -->
<ui version="4.0">
 <class>TrashPage</class>
 <widget class="QWidget" name="TrashPage">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>640</width>
    <height>480</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="rootLayout" stretch="0,1">
   <property name="leftMargin">
    <number>20</number>
   </property>
   <property name="topMargin">
    <number>16</number>
   </property>
   <property name="rightMargin">
    <number>20</number>
   </property>
   <property name="bottomMargin">
    <number>16</number>
   </property>
   <property name="spacing">
    <number>10</number>
   </property>
   <item>
    <layout class="QHBoxLayout" name="head">
     <item>
      <widget class="QLabel" name="TrashTitle">
       <property name="text">
        <string>回收站</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="countLabel"/>
     </item>
     <item>
      <spacer name="headStretch">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="btnRestore">
       <property name="text">
        <string>恢复</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnDelete">
       <property name="text">
        <string>永久删除</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnClear">
       <property name="text">
        <string>清空回收站</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QListWidget" name="TrashList">
     <property name="verticalScrollMode">
      <enum>QAbstractItemView::ScrollPerPixel</enum>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
